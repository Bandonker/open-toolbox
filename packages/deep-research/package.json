    "lib/command-registry.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "research",
    "deep-research",
    "agents",
    "analysis",
    "report",
    "parallel"
  ],
  "homepage": "https://github.com/Bandonker/open-toolbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bandonker/open-toolbox.git"
