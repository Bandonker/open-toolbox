    "index.js",
    "helpers.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "sessions",
    "subagents",
    "handoff",
    "orchestration",
    "presence"
  ],
  "homepage": "https://github.com/Bandonker/open-toolbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bandonker/open-toolbox.git"
  },
  "bugs": "https://github.com/Bandonker/open-toolbox/issues",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.11"
  },
  "dependencies": {
    "zod": "4.1.8"
  }
}
