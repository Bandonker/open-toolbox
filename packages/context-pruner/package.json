{
  "name": "@bandonker/opencode-context-pruner",
  "version": "1.2.1",
  "description": "Context compiler for opencode v2: token-accurate pruning with a cache-stable epoch scheduler (session.hook context). Measures real tokens, plans changes once per epoch, dedupes and purges stale output, and never touches the transcript on disk.",
